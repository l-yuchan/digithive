{
  "name": "@digithive/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "start": "bun src/server/main.ts",
    "build:web": "bun scripts/build-web.ts",
    "lint": "bun src/sdk/gen-script-sdk.ts && oxlint --type-aware --deny-warnings --report-unused-disable-directives src tests scripts web/src web/sw.js lint",
    "fmt": "oxfmt src tests scripts web/src web/index.html web/sw.js lint package.json tsconfig.json .oxlintrc.json .oxfmtrc.json README.md",
    "fmt:check": "bun run fmt --check",
    "typecheck": "bun src/sdk/gen-script-sdk.ts && tsc --noEmit",
    "test": "bun src/sdk/gen-script-sdk.ts && bun test",
    "mock": "bun scripts/mock-provider.ts",
    "verify": "bun run lint && bun run typecheck && bun run build:web && bun test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^5.9.3"
  }
}
