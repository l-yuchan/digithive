{
  "name": "@digithive/assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "start": "bun src/server/main.ts",
    "worker": "bun scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "verify": "bun run typecheck && bun run build && bun test",
    "qa": "bun scripts/qa.ts",
    "doctor": "bun scripts/doctor.ts"
  },
  "dependencies": {
    "ky": "2.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "typescript": "5.9.3"
  }
}
